{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "localloom",
  "description": "Local-first AI coding agent powered by Ollama",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --cwd packages/cli src/index.ts",
    "dev:live": "sh -c 'OPENCODE_TUI_CHANNEL=dev OPENCODE_PASSWORD=\"$(opencode service get password)\" exec bun run dev \"$@\" --server \"$(opencode service status)\"' --",
    "typecheck": "bun turbo typecheck",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.1",
      "@effect/platform-node": "4.0.1",
      "@effect/platform-node-shared": "4.0.1",
      "@effect/sql-sqlite-bun": "4.0.1",
      "@lydell/node-pty": "1.2.0-beta.12",
      "@npmcli/arborist": "9.4.0",
      "@opentui/core": "0.6.6",
      "@opentui/keymap": "0.6.6",
      "@opentui/solid": "0.6.6",
      "@standard-schema/spec": "1.1.0",
      "@tsconfig/bun": "1.0.9",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.4.0",
      "@types/cross-spawn": "6.0.6",
      "@types/node": "24.12.2",
      "@typescript/native": "npm:typescript@7.0.2",
      "cross-spawn": "7.0.6",
      "diff": "8.0.4",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-169397b",
      "effect": "4.0.1",
      "fast-check": "4.9.0",
      "fuzzysort": "3.1.0",
      "get-east-asian-width": "1.6.0",
      "remeda": "2.26.0",
      "solid-js": "1.9.15",
      "string-width": "7.2.0",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "vite": "7.3.6",
      "vite-plugin-solid": "2.11.10",
      "zod": "4.1.8"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "prettier": "3.6.2",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/script": "workspace:*",
    "typescript": "catalog:"
  },
  "license": "MIT",
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs"
  ],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "1.4.2",
    "effect": "catalog:",
    "open": "11.0.4",
    "solid-js": "catalog:"
  },
  "patchedDependencies": {
    "@ai-sdk/openai-compatible@2.0.41": "patches/@ai-sdk%2Fopenai-compatible@2.0.41.patch",
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "solid-js@1.9.15": "patches/solid-js@1.9.15.patch",
    "pacote@21.5.1": "patches/pacote@21.5.1.patch",
    "@ff-labs/fff-bun@0.10.5": "patches/@ff-labs%2Ffff-bun@0.10.5.patch",
    "vite@8.2.2": "patches/vite@8.2.2.patch",
    "@modelcontextprotocol/client@2.0.0": "patches/@modelcontextprotocol%2Fclient@2.0.0.patch"
  }
}