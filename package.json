{
  "name": "localloom",
  "version": "0.1.0",
  "description": "Minimal local-first multi-agent coding TUI",
  "type": "module",
  "bin": {
    "localloom": "bin/localloom.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "start": "node bin/localloom.js",
    "tui": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent": "tsx src/cli.ts",
    "link": "npm link"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "node-pty": "^1.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
